# 企业微信智能机器人长连接
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 本地调试可设为 false（见 scripts/start_local.sh）；生产保持 true
ENABLE_WECOM_BOT=true
# 源群 chatid 到副群 chatid 的同步推送映射，JSON 单行；副群失败不影响主群发送状态
# 例：WECOM_MIRROR_GROUPS={"group_chatid_1":["group_chatid_2"],"group_chatid_2":["group_chatid_3","group_chatid_4"]}
WECOM_MIRROR_GROUPS=
# 通用同步推送映射，支持个人和群；推荐新配置用这个，格式是 user:<用户ID> / group:<群chatid>
# 例：WECOM_MIRROR_SCOPES={"user:user_id_1":["group:group_chatid_1"],"group:group_chatid_1":["user:user_id_2","group:group_chatid_2"]}
WECOM_MIRROR_SCOPES=
# 临时调试：在日志里输出收到的群 chatid
WECOM_DEBUG_CHAT_ID_LOG=false

# LLM（Pydantic AI AlibabaProvider / DashScope）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max
LLM_ENABLE_THINKING=false
LLM_INVOKE_WALL_TIMEOUT_SEC=90

# 应用与本地数据库
APP_HOST=0.0.0.0
APP_PORT=8100
APP_DEBUG=false
DATA_DIR=./data
SCHEDULER_TIMEZONE=Asia/Shanghai
AGENT_VERSION=v0.2

# 本地日志；每天写入 app_YYYY-MM-DD.log，超过保留天数自动清理
LOG_DIR=./data/logs
LOG_RETENTION_DAYS=30
LOG_CONSOLE=false

# 后台接口
ADMIN_INIT_TOKEN=

# 模型输入快照
MODEL_INPUT_SNAPSHOT_DIR=./data/model_input_snapshots

# Logfire 运行监控
LOGFIRE_ENABLED=true
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
LOGFIRE_SERVICE_NAME=hall-agent
LOGFIRE_ENVIRONMENT=local
LOGFIRE_CONSOLE=false
LOGFIRE_PYDANTIC_RECORD=failure
